# Harness identity family — the single declaration point for the disposable
# Development Host's fixture ports, SSH alias, user, and image name.
# Consumers: test-host-up/test-host-down and test-integration (source this
# file), compose.yaml (env interpolation), entrypoint.sh inside the container
# (env with defaults), and the Go integration test (defaults in
# cli/integration/sshhost/forward_test.go). Change a value here and every
# consumer follows.
SSH_FORWARD_FIXTURE_PORT_V4=38080
SSH_FORWARD_FIXTURE_PORT_V6=38081
SSH_FORWARD_FIXTURE_PORT_DUAL_STACK=38082
SSH_FORWARD_FIXTURE_PORT_AUTO=38084
SSH_FORWARD_FIXTURE_PORT_REVERSE=38085
SSH_FORWARD_FIXTURE_PORT_CONFIG_LOCAL=38086
SSH_FORWARD_FIXTURE_PORT_CONFIG_REMOTE=38087
SSH_FORWARD_FIXTURE_PORT_REVERSE_SECOND=38088
SSH_FORWARD_TEST_HOST_ALIAS=ssh-forward-test-host
SSH_FORWARD_TEST_UNSAFE_HOST_ALIAS=ssh-forward-test-host-gatewayports-yes
SSH_FORWARD_TEST_USER=testdev
SSH_FORWARD_TEST_IMAGE=ssh-forward-test-host
