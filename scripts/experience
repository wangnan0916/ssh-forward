#!/bin/sh

# Exercise the complete product against a disposable Linux SSH host without
# touching the user's SSH configuration.

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
keep=0
case "${1:-}" in
    '') ;;
    --keep) keep=1 ;;
    *) printf 'usage: scripts/experience [--keep]\n' >&2; exit 2 ;;
esac

docker version >/dev/null 2>&1 || {
    printf 'experience: Docker is required\n' >&2
    exit 1
}

run_id=exp-$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')
export SSH_FORWARD_TEST_RUN_ID=$run_id
export SSH_FORWARD_TEST_DOCKER_CONTEXT=$(docker context show)
ssh_config=$("$root/scripts/internal/test-host-up" | tail -1)
state_dir="$root/.tmp/integration/$run_id"
config_dir="$state_dir/config"
mkdir -p "$config_dir"
printf '{"schema_version":1,"default_host":"ssh-forward-test-host"}\n' > "$config_dir/config.jsonc"

server_pid=''
cleanup() {
    status=$?
    trap - 0 HUP INT TERM
    if [ -n "$server_pid" ]; then
        kill -TERM "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    if [ "$keep" -eq 0 ]; then
        "$root/scripts/internal/test-host-down" || status=1
    else
        printf 'kept host; stop with: SSH_FORWARD_TEST_RUN_ID=%s scripts/internal/test-host-down\n' "$run_id"
    fi
    exit "$status"
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' TERM

binary="$state_dir/ssh-forward"
(cd "$root/cli" && go build -o "$binary" ./cmd/ssh-forward)
SSH_FORWARD_CONFIG_DIR="$config_dir" "$binary" \
    --host ssh-forward-test-host --ssh-config "$ssh_config" manager serve \
    > "$state_dir/manager.log" 2>&1 &
server_pid=$!
sleep 1

step() { printf '\n== %s ==\n' "$1"; }

step "remote listeners"
SSH_FORWARD_CONFIG_DIR="$config_dir" "$binary" status

step "remember and activate port 38080"
SSH_FORWARD_CONFIG_DIR="$config_dir" "$binary" add 38080
sleep 3
SSH_FORWARD_CONFIG_DIR="$config_dir" "$binary" status

step "round trip"
printf 'hello\n' | nc -w 3 127.0.0.1 38080 || \
    printf '(nc unavailable; status still verifies the forward)\n'

step "forget port 38080"
SSH_FORWARD_CONFIG_DIR="$config_dir" "$binary" remove 38080
sleep 1
SSH_FORWARD_CONFIG_DIR="$config_dir" "$binary" status

step "DONE"
