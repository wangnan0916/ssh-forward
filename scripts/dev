#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
dev_bin="$root/.tmp/dev/ssh-forward"
fail() { printf '%s\n' "$*" >&2; exit 1; }
full_stack=0
if [ "${1:-}" = --full ]; then full_stack=1; shift; fi
[ "$#" -gt 0 ] || set -- status
baseline_bin=${SSH_FORWARD_DEV_BASELINE:-$(command -v ssh-forward || true)}
[ -n "$baseline_bin" ] && [ -x "$baseline_bin" ] || fail 'Install ssh-forward or set SSH_FORWARD_DEV_BASELINE to an installed binary.'
baseline_dir=$(CDPATH= cd -- "$(dirname -- "$baseline_bin")" && pwd)
baseline_bin="$baseline_dir/$(basename -- "$baseline_bin")"
[ "$baseline_bin" != "$dev_bin" ] || fail 'The baseline must not be the development binary.'
version_line=$("$baseline_bin" --version)
case "$version_line" in
    'ssh-forward '*) baseline_version=${version_line#ssh-forward } ;;
    *) fail "Could not read version from $baseline_bin: $version_line" ;;
esac
case "$baseline_version" in ''|*[!A-Za-z0-9._+-]*) fail "Unsupported baseline version: $baseline_version" ;; esac

# Ensure the installed Manager is healthy before swapping the client or service.
"$baseline_bin" status --json </dev/null >/dev/null || fail "Could not prepare $baseline_bin"
mkdir -p "$(dirname -- "$dev_bin")"
if [ "$full_stack" -eq 1 ]; then
    go -C "$root/cli" build -o "$dev_bin" ./cmd/ssh-forward
else
    go -C "$root/cli" build -buildvcs=false -ldflags "-X main.buildVersion=$baseline_version" -o "$dev_bin" ./cmd/ssh-forward
fi
restore_manager() {
    status=$?
    trap - 0 HUP INT TERM
    if ! "$baseline_bin" status --json </dev/null >/dev/null 2>&1; then
        printf 'Could not restore installed Manager with %s\n' "$baseline_bin" >&2
        [ "$status" -ne 0 ] || status=1
    fi
    exit "$status"
}
trap restore_manager 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
"$dev_bin" "$@"
